root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = intellij_idea
ij_kotlin_indent_size = 2
ij_kotlin_continuation_indent_size = 2
ij_kotlin_tab_width = 2

[*.java]
ij_java_indent_size = 2
ij_java_continuation_indent_size = 2
ij_java_tab_width = 2
